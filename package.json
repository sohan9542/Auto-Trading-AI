{
  "name": "crypto-ai-trading-bot",
  "version": "1.0.0",
  "description": "AI-assisted crypto trading bot with Telegram controls, risk limits, and paper/live modes",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test tests/**/*.test.js",
    "backtest": "node scripts/backtest.js"
  },
  "keywords": [
    "crypto",
    "trading-bot",
    "binance",
    "telegram",
    "anthropic",
    "nodejs"
  ],
  "author": "Sohanur Rahman",
  "private": true,
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "axios": "^1.6.0",
    "dotenv": "^16.3.1",
    "node-cron": "^3.0.3",
    "node-telegram-bot-api": "^0.66.0",
    "pg": "^8.11.0",
    "technicalindicators": "^3.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.10"
  }
}
