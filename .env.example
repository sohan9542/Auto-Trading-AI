# ============================================
# CRYPTO AI TRADING BOT - ENVIRONMENT CONFIG
# ============================================

# Telegram Bot (get from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Anthropic API (console.anthropic.com)
ANTHROPIC_API_KEY=

# Binance API (binance.com → API Management)
# For paper trading: only needs read permission
# For live trading: needs read + spot trade permission
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Neon Database (neon.tech → create free project → copy connection string)
DATABASE_URL=

# CryptoPanic API (cryptopanic.com → free account → API key)
CRYPTOPANIC_API_KEY=your_cryptopanic_api_key_here

# Bot Settings (you can change these anytime)
TRADING_MODE=paper          # paper or live
MAX_RISK_PER_TRADE=1.5      # % of portfolio per trade
MAX_OPEN_TRADES=3           # max simultaneous trades
MIN_CONFIDENCE=55           # minimum AI confidence % to trade (was 72 — too high)
DAILY_LOSS_LIMIT=4          # % max loss per day before pause
WEEKLY_LOSS_LIMIT=8         # % max loss per week before pause
TRADE_PAIRS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT # pairs to trade
ANALYSIS_INTERVAL=4h        # how often to run full analysis
PORTFOLIO_SIZE=1000         # your starting capital in USDT

# RSI+EMA Strategy (runs alongside the AI strategy)
ENABLE_RSI_EMA=true         # multi-trigger confluence strategy
EMA_FAST=9                  # fast EMA period
EMA_SLOW=21                 # slow EMA period
EMA_TREND=200               # trend filter EMA period
SL_ATR_MULT=2.0             # stop loss = N x ATR
TP1_RR=1.5                  # take profit 1 reward multiple (50% position closed here)
TP2_RR=3.0                  # take profit 2 reward multiple (remaining 50% closed here)
